<body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W5W3L42G" height="0" width="0"
            style="display:none;visibility:hidden"></iframe></noscript>
    <div class="me">
        <div id="animation-container"></div>
        <div class="shadow"></div>
    </div>
    <section class="nav">
        <ul class="top">
            <a href="/">home</a>
            <a href="/likes">likes</a>
            <a class="current" href="/minerals">minerals</a>
        </ul>
        <ul class="bottom">
            <a href="https://www.are.na/pj-rosa/blocks" target="_blank">are.na</a>
            <a href="https://www.linkedin.com/in/pjrosa/" target="_blank">linkedin</a>
            <a href="https://discord.com/invite/srk3VVxt" target="_blank">discord </a>
            <a href="https://www.instagram.com/spoooji/" target="_blank">instagram </a>
            <a href="https://letterboxd.com/spooji/" target="_blank">letterboxd </a>
        </ul>
    </section>
    <section class="arena-feed">
        <button class="thumbnail-toggle-btn" id="thumbnail-toggle-btn" aria-label="Toggle thumbnail size"><span class="option">smaller</span> <span class="option">larger</span></button>
        <button class="thumbnail-grid-btn" id="thumbnail-grid-btn" aria-label="Toggle grid layout"><span class="option">list</span> <span class="option">grid</span></button>
        <button class="scroll-top-btn" id="scroll-top-btn" aria-label="Scroll to top">↑ top</button>
        <div class="inspiration-about">
            I'm into minerals and like to document all the ones I've collected :3
            <div class="stats">
                <span class="total-blocks"><span class="label">Total rocks:</span>
                    <%= totalBlocks %>
                </span>
                <span class="likes-last-updated"><span class="label">Last updated:</span> <span id="last-updated-date"
                        data-timestamp="<%= updatedAt %>">Loading Date...</span></span>
                <span class="source"><span class="label">Source feed:</span> <a
                        href="https://www.are.na/pj-rosa/my-rock-slop" target="_blank">are.na</a></span>
            </div>
        </div>
        <div class="mineral-gallery-container">
            <div id="main-block-display" class="main-block-view">
                <div class="image-area">
                    <div id="loading-placeholder" class="loading-placeholder">Loading Image...</div>
                    <img id="main-image" src="" alt="Selected Mineral Image">
                </div>
                <div class="details-area mobile">
                    <h2 id="main-title" class="image-title main-title-text"></h2>
                    <div id="main-description" class="block-description main-description-text"></div>
                    <div id="special-details-area" class="special-details-area"></div>
                </div>
                <div class="bottom">
                    <div class="details-area desktop">
                        <h2 id="main-title" class="image-title main-title-text"></h2>
                        <div id="main-description" class="block-description main-description-text"></div>
                        <div id="special-details-area" class="special-details-area"></div>
                    </div>
                    <div id="channel-content" class="scroll-snap-type">
                        <div id="channel-slug" data-value="<%= channelSlug %>" style="display: none;"></div>
                        <div id="total-pages" data-value="<%= totalPages %>" style="display: none;"></div>
                        <div id="current-page" data-value="<%= currentPage %>" style="display: none;"></div>
                        <div id="last-updated-date" data-timestamp="<%= updatedAt %>" style="display: none;"></div>

                        <% channelBlocks.forEach(function(block) { %>
                            <% if (block.image && block.image.original && block.image.thumb) { %>
                            <div class="channel-block-thumbnail">
                                <a href="javascript:void(0);" 
                                class="gallery-thumbnail-link" 
                                data-original-url="<%= block.image.original.url %>"
                                data-thumb-url="<%= block.image.thumb.url %>"
                                data-title="<%= block.title %>"
                                data-content="<%- encodeURIComponent(JSON.stringify(block.description)) %>"
                                >
                                    <img src="<%= block.image.thumb.url %>" alt="<%= block.title %>" onerror="this.onerror=null; this.src='https://placehold.co/100x75?text=Error';">
                                </a>
                            </div>
                            <% } %>
                        <% }); %>
                        <div id="loading-spinner" style="display: none;">Loading...</div>
                    </div>
                </div>
            </div>
            <a class="back-button" href="/">back</a>
            <div id="loading-spinner" style="text-align: center; padding: 20px;
font-weight: bold;"></div>
    </section>
