<section class="arena-feed">
    <button class="thumbnail-toggle-btn" id="thumbnail-toggle-btn" aria-label="Toggle thumbnail size"><span class="option">smaller</span> <span class="option">larger</span></button>
    <button class="thumbnail-grid-btn" id="thumbnail-grid-btn" aria-label="Toggle grid layout"><span class="option">list</span> <span class="option">grid</span></button>
    <button class="scroll-top-btn" id="scroll-top-btn" aria-label="Scroll to top">↑ top</button>
    <div class="inspiration-about">
        Automated feed of my curated likes from twitter, instagram, are.na, threads, and some personal posts. The rough throughline being colors, compositions, and textures that tickle my brain. 
        <div class="stats">
            <span class="total-blocks"><span class="label">Total likes:</span> <%= totalBlocks %></span>
            <span class="likes-last-updated"><span class="label">Last updated:</span> <span id="last-updated-date" data-timestamp="<%= updatedAt %>">Loading Date...</span></span>
            <span class="source"><span class="label">Source feed:</span> <a href="https://www.are.na/pj-rosa/blocks" target="_blank">are.na</a></span>
        </div>
    </div>
    <p></p>
    <div id="channel-content" class="channel-content">
        <% channelBlocks.forEach(block => { %>
            <div class="channel-block">
                <% if (block.image && block.image.original) { %>
                    <%
                        const sourceUrl = block.source && block.source.url ? block.source.url : '#';
                    %>
                    <a href="javascript:void(0);" class="image-link"
                       data-original-url="<%= block.image.original.url %>"
                       data-title="<%= block.title || 'Are.na Image Block' %>"
                       data-source-url="<%= sourceUrl %>">
                        <img src="<%= block.image.thumb.url %>"
                             alt="<%= block.title || 'Are.na Image Block' %>"
                             onerror="this.onerror=null;this.src='https://placehold.co/400x300/F0F0F0/606060?text=Image+Error'">
                    </a>
                <% } else if (block.content) { %>
                    <div class="block-content">
                        <p><%= block.content %></p>
                    </div>
                <% } else if (block.source && block.source.url) { %>
                    <%
                        const sourceUrl = block.source && block.source.url ? block.source.url : '#';
                    %>
                    <div class="block-link">
                        <p class="block-title"><%= block.title || 'Link Block' %></p>
                        <p class="block-source">
                            <a href="<%= sourceUrl %>" target="_blank">View Source</a>
                        </p>
                    </div>
                <% } else { %>
                    <p>Unsupported Block Type</p>
                <% } %>
            </div>
        <% }); %>
    </div>
