    <div id="channel-content" class="channel-content">
        <% channelBlocks.forEach(block => { %>
            <div class="channel-block">
                <% if (block.image && block.image.original) { %>
                    <!-- MODIFIED: Image Block wrapped in a clickable link -->
                    <a href="javascript:void(0);" class="image-link"
                       data-original-url="<%= block.image.original.url %>"
                       data-title="<%= block.title || 'Are.na Image Block' %>"
                       data-source-url="<%= block.source.url %>">
                        <!-- Use the 'display' URL for the thumbnail/grid view -->
                        <img src="<%= block.image.thumb.url %>"
                             alt="<%= block.title || 'Are.na Image Block' %>"
                             onerror="this.onerror=null;this.src='https://placehold.co/400x300/F0F0F0/606060?text=Image+Error'">
                    </a>
                <% } else if (block.content) { %>
                    <!-- Text Block (simple rendering) -->
                    <div class="block-content">
                        <p><%= block.content %></p>
                    </div>
                <% } else if (block.source && block.source.url) { %>
                    <!-- Link Block -->
                    <div class="block-link">
                        <p class="block-title"><%= block.title || 'Link Block' %></p>
                        <p class="block-source">
                            <a href="<%= block.source.url %>" target="_blank">View Source</a>
                        </p>
                    </div>
                <% } else { %>
                    <!-- Fallback -->
                    <p>Unsupported Block Type</p>
                <% } %>
            </div>
        <% }); %>
    </div>
<div id="full-image-modal" class="modal">
    <!-- Modal Content Area -->
    <div class="modal-content">

        <!-- Close Button -->
        <span id="modal-close-btn" class="close-btn">&times;</span>

        <!-- Loading Placeholder -->
        <!-- This is shown when the modal opens and hidden when the image loads -->
        <div id="modal-placeholder" class="loading-placeholder">
            Loading Full Image...
        </div>

        <!-- High-Resolution Image -->
        <!-- This is initially hidden (style="display: none;" or via CSS) -->
        <img id="modal-image" src="" alt="Full resolution image" class="full-image">
                <!-- Image Title/Caption -->
        <a id="modal-title-link" href="#" target="_blank" class="image-title">
            <h2 id="modal-title"></h2>
        </a>
    </div>
</div>
