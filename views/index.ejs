<!-- Contact Modal -->
<div id="contact-modal" class="contact-modal">
    <div class="contact-modal-content">
        <span class="contact-close-btn" id="contact-close-btn">&times;</span>
        <h2>send me a message!</h2>
        <p>i appreciate any messages, i'll probably respond.</p>
        <form id="contact-form">
            <input type="email" id="contact-email" name="email" placeholder="your email" required>
            <textarea id="contact-message" name="message" placeholder="your message" rows="4" required></textarea>
            <!-- Honeypot field - hidden from users but visible to bots -->
            <input type="text" id="website-url" name="website" tabindex="-1" autocomplete="off" style="position: absolute; left: -9999px; opacity: 0;">
            <button type="submit" id="contact-submit">send</button>
        </form>
        <div id="contact-status" class="contact-status"></div>
    </div>
</div>
