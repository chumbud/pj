{
  "name": "arena-server",
  "version": "1.0.0",
  "description": "Server-side rendering for Are.na channel content.",
  "main": "server.js",
  "scripts": {
    "sass-dev": "sass --watch public/scss:public/css --style=expanded",
    "sass-prod": "sass public/scss:public/css --style=compressed --no-source-map",
    "serve": "npm-run-all --parallel sass-dev dev",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.8",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.9",
    "express": "^4.18.3",
    "nodemailer": "^7.0.12",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "sass": "^1.93.3"
  }
}
